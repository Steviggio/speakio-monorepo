# ── Build stage ──────────────────────────────────────────
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/agent-api ./cmd/api

# ── Runtime stage ────────────────────────────────────────
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 1001 appuser

COPY --from=builder /bin/agent-api /bin/agent-api
COPY --from=builder /app/migrations /app/migrations

USER appuser
WORKDIR /app

EXPOSE 3010

ENTRYPOINT ["/bin/agent-api"]
