# ── Build stage ──────────────────────────────────────────
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/agent-worker ./cmd/worker

# ── Runtime stage ────────────────────────────────────────
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 1001 appuser

COPY --from=builder /bin/agent-worker /bin/agent-worker

USER appuser
WORKDIR /app

ENTRYPOINT ["/bin/agent-worker"]
