# ══════════════════════════════════════════════════════
#  Speakio — Production Environment Variables
#  Copy to .env.production and fill in real values.
#  NEVER commit .env.production to version control.
# ══════════════════════════════════════════════════════

# ── Core ──
NODE_ENV=production
PORT=3001

# ── Domains ──
NEXT_PUBLIC_SITE_URL=https://www.speakio.fr
NEXT_PUBLIC_API_URL=http://api:3001
NEXT_PUBLIC_CLIENT_API_URL=https://www.speakio.fr/api
ALLOWED_ORIGINS=https://www.speakio.fr,https://speakio.fr,https://www.speakio.eu,https://speakio.eu

# ── Auth ──
JWT_SECRET=          # Generate with: openssl rand -hex 64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://www.speakio.fr/api/auth/google/callback

# ── MongoDB ──
MONGODB_ROOT_USER=speakio_admin
MONGODB_ROOT_PASSWORD=   # Generate with: openssl rand -hex 32
MONGODB_URI=             # mongodb://<user>:<pass>@mongo:27017/speakio?authSource=admin

# ── Admin Seed ──
ADMIN_EMAIL=             # Your admin email
ADMIN_USERNAME=          # Your admin username
ADMIN_PASSWORD=          # Strong password for admin account

# ── Grafana ──
GF_SECURITY_ADMIN_PASSWORD=   # Generate with: openssl rand -hex 24

# ── Umami ──
UMAMI_POSTGRES_PASSWORD=      # Generate with: openssl rand -hex 32
UMAMI_APP_SECRET=             # Generate with: openssl rand -hex 32
NEXT_PUBLIC_UMAMI_URL=https://www.speakio.fr/umami
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── SSL / Certbot ──
CERTBOT_EMAIL=               # Your email for Let's Encrypt notifications
